{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Switchboard",
  "version": "0.2.3",
  "identifier": "dev.switchboard.desktop",
  "build": {
    "frontendDist": "../frontend",
    "beforeBuildCommand": "node scripts/stage.mjs",
    "beforeDevCommand": "node scripts/stage.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "msi",
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Brett Boggs",
    "homepage": "https://brettboggs.dev",
    "category": "Productivity",
    "shortDescription": "Everything that needs you, on one screen",
    "longDescription": "Switchboard is a local console for your coding agents, mail, chats, reminders and money. It runs on this computer only.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/switchboard-node"
    ],
    "resources": {
      "../build/switchboard/": "server/"
    },
    "linux": {
      "deb": {
        "recommends": [
          "tmux",
          "curl",
          "git"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3QzNBMEFDRUMzODJCNDYKUldSR0t6anNyS0RERjVqc2hVWEhHWGtiYjBsVkVKTGdJTWFpWCt6UXhGY05YU0tnNE1IVkx6OGIK",
      "endpoints": [
        "https://github.com/brettmboggs/switchboard-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
