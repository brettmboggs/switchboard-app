{
  "name": "switchboard",
  "version": "0.2.10",
  "private": true,
  "license": "FSL-1.1-MIT",
  "description": "One screen for everything you run: AI coding sessions, builds, email, chats, calendar, reminders and money, on your own computer.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "open": "node bin/open.mjs",
    "setup": "node scripts/setup.mjs install",
    "uninstall": "node scripts/setup.mjs remove",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "publish": "node scripts/publish.mjs",
    "lint": "node scripts/page-globals.mjs && eslint .",
    "notices": "node scripts/notices.mjs",
    "pitch": "node scripts/pitch.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "imapflow": "2.10.0",
    "mailparser": "3.14.1",
    "node-pty": "1.1.0",
    "nodemailer": "10.3.1",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "eslint": "10.14.0"
  }
}
